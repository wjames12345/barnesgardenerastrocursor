---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SideNav from '../components/SideNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const DEFAULT_TITLE = 'The Barnes Gardener · Gary Hazell';
const DEFAULT_DESCRIPTION = 'Considered, sustainable gardening for Barnes and South West London. By Gary Hazell, independent since 2016.';
const DEFAULT_OG_IMAGE = '/logo-wordmark.png';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;

// data-mob-page drives the mobile section visibility rules at source 4143–4162.
// /quoteandrender maps to "generator" — mobile uses the "generator" slug for the
// Quote-and-Render page (matches #m-generator markup).
const PATH_TO_MOB_PAGE: Record<string, string> = {
  '/':         'home',
  '/about':    'about',
  '/services': 'services',
  '/gardens':  'gardens',
  '/quoteandrender': 'generator',
  '/blog':     'blog',
  '/podcast':  'podcast',
  '/shop':     'shop',
  '/contact':  'contact',
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// /case/[road] sub-routes have no mobile equivalent in source; fall back to
// "gardens" so mobile users land on the gardens grid rather than the home wordmark.
const mobPage = path.startsWith('/case/') ? 'gardens' : (PATH_TO_MOB_PAGE[path] ?? 'home');

// Canonical and absolute OG image URL — Astro.site is set in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL   = new URL(ogImage, Astro.site).toString();

// LocalBusiness JSON-LD — boosts "barnes gardener" / "gardener barnes" queries.
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'The Barnes Gardener',
  description: DEFAULT_DESCRIPTION,
  url: Astro.site?.toString(),
  telephone: '+447770450523',
  email: 'gary@thebarnesgardener.co.uk',
  priceRange: '££',
  founder: { '@type': 'Person', name: 'Gary Hazell' },
  foundingDate: '2016',
  areaServed: [
    'Barnes', 'Richmond', 'Wimbledon', 'Kingston', 'Putney',
    'Chelsea', 'Kensington', 'Notting Hill', 'Brentford', "Shepherd's Bush",
  ],
  sameAs: ['https://instagram.com/thebarnesgardener'],
  image: new URL('/logo-wordmark.png', Astro.site).toString(),
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no, viewport-fit=cover">

<!-- Hash-route migration shim: catches inbound links from the old SPA's
     /#about /#services etc. and redirects to /about /services etc. before paint.
     Inert when no hash is present. /#case and /#map fall back to /gardens since
     deep-link road state isn't preserved across the migration. -->
<script is:inline>
  (function () {
    var h = location.hash.replace(/^#m?-?/, '');
    if (!h) return;
    var map = {
      home: '/', about: '/about', services: '/services', gardens: '/gardens',
      quoteandrender: '/quoteandrender', generator: '/quoteandrender', blog: '/blog',
      podcast: '/podcast', shop: '/shop', contact: '/contact',
      'case': '/gardens', map: '/gardens'
    };
    var target = map[h];
    if (target && location.pathname !== target) location.replace(target);
  })();
</script>

<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F7F2E5">
<meta name="color-scheme" content="light">

<link rel="canonical" href={canonicalURL}>

<meta property="og:type" content="website">
<meta property="og:site_name" content="The Barnes Gardener">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta property="og:locale" content="en_GB">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageURL}>

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Gary">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<link rel="manifest" href="/manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="/BULB TO FLOWER transparent.png" fetchpriority="high">
<link rel="preload" as="image" href="/hazell-twigg-1row.png" fetchpriority="high">
<link rel="preload" as="image" href="/logo-wordmark.png" fetchpriority="high">

<script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

<ClientRouter />

<!-- Smart page-transition loader, synchronised to the real load time.
     Fast navs (< THRESHOLD) show nothing — no flash. When the loader does
     show, the ring + bulb are driven by ONE shared JS clock (so they never
     drift apart like two independent CSS loops would), and the cycle length
     is fitted to a rolling estimate of how long this site's navigations take:
       • short load  → ONE fast full cycle that fits the window,
       • long load   → N calm cycles (N = round(window / comfortable cycle)).
     The crucial bit: when the page is actually ready we never hard-cut the
     animation mid-frame — we gracefully complete the current cycle (ring back
     to 12 o'clock, bulb at full bloom) within <=FINISH_MS, then fade out. -->
<script is:inline>
  (function () {
    var THRESHOLD   = 200;    // navs faster than this never show the loader
    var COMFORTABLE = 1100;   // a calm full cycle (ms)
    var FAST_MIN    = 450;    // fastest a full cycle is allowed to run
    var FINISH_MS   = 280;    // max time to gracefully finish the cycle once ready
    var EMA_KEY     = 'navDurEMA';
    var reduced     = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var loader, arc, frames;
    function refs() {
      loader = document.getElementById('loader');
      if (!loader) return false;
      arc = loader.querySelector('.loader-ring__arc');
      frames = loader.querySelectorAll('.bulb-frame');
      return true;
    }

    // Rolling estimate (EMA) of nav duration, persisted for the session.
    function getEMA() {
      var v = parseFloat(sessionStorage.getItem(EMA_KEY));
      return (isFinite(v) && v > 0) ? v : 700;
    }
    function pushEMA(d) {
      if (!(d > 0) || d > 20000) return;
      var next = getEMA() * 0.65 + d * 0.35;
      try { sessionStorage.setItem(EMA_KEY, String(Math.round(next))); } catch (_) {}
    }

    var navStart = 0, showTimer = null, rafId = null;
    var animStart = 0, cycleMs = COMFORTABLE;
    var finishing = false, finishStart = 0, finishFrom = 0, finishDur = 0;

    // Render one moment of the cycle. p in [0,1]: 0 = start, 1 = full bloom.
    function render(p) {
      if (arc) arc.style.transform = 'rotate(' + (-90 + 360 * p) + 'deg)';
      if (frames && frames.length) {
        var idx = p >= 1 ? frames.length - 1 : Math.floor(p * frames.length);
        if (idx > frames.length - 1) idx = frames.length - 1;
        for (var i = 0; i < frames.length; i++) {
          frames[i].style.opacity = (i === idx) ? '1' : '0';
        }
      }
    }

    function frame(now) {
      if (!finishing) {
        render(((now - animStart) % cycleMs) / cycleMs);
        rafId = requestAnimationFrame(frame);
      } else {
        var t = finishDur > 0 ? (now - finishStart) / finishDur : 1;
        if (t >= 1) { render(1); doHide(); return; }
        var e = 1 - Math.pow(1 - t, 2);          // ease-out to the cycle end
        render(finishFrom + (1 - finishFrom) * e);
        rafId = requestAnimationFrame(frame);
      }
    }

    function showLoader() {
      if (!refs()) return;
      // Size the cycle so a whole number of cycles fills the expected window.
      var visible = Math.max(getEMA() - THRESHOLD, FAST_MIN);
      var n = Math.max(1, Math.round(visible / COMFORTABLE));
      cycleMs = Math.min(Math.max(visible / n, FAST_MIN), COMFORTABLE);
      finishing = false;
      animStart = performance.now();
      loader.classList.add('loader--js', 'visible');
      if (reduced) { render(1); return; }        // static bloom, no spin
      rafId = requestAnimationFrame(frame);
    }

    // Page is ready: finish the current cycle smoothly instead of chopping it.
    function beginFinish() {
      if (!loader || !loader.classList.contains('visible')) return;
      if (reduced || finishing) { doHide(); return; }
      var now = performance.now();
      finishFrom = ((now - animStart) % cycleMs) / cycleMs;
      finishStart = now;
      finishDur = Math.min((1 - finishFrom) * cycleMs, FINISH_MS);
      finishing = true;
      if (rafId === null) rafId = requestAnimationFrame(frame);
    }

    function doHide() {
      if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      finishing = false;
      if (loader) loader.classList.remove('visible');
      setTimeout(function () { if (loader) loader.classList.remove('loader--js'); }, 220);
    }

    document.addEventListener('astro:before-preparation', function () {
      navStart = performance.now();
      if (showTimer) clearTimeout(showTimer);
      showTimer = setTimeout(showLoader, THRESHOLD);
    });
    document.addEventListener('astro:after-swap', function () {
      if (showTimer) { clearTimeout(showTimer); showTimer = null; }
      if (navStart) { pushEMA(performance.now() - navStart); navStart = 0; }
      beginFinish();
    });
    document.addEventListener('astro:before-swap', function () {
      if (showTimer) { clearTimeout(showTimer); showTimer = null; }
    });
  })();
</script>

<!-- Custom cursor IIFE — lifted verbatim from source script B 8051–8110.
     Runs once on initial load; window listeners + persisted DOM survive
     view transitions. The init waits for DOMContentLoaded so the cursor
     elements exist when the script first looks for them — the original
     bug was the script firing in <head> before the body parsed and
     ensureRefs() returning null. -->
<script is:inline>
  (function () {
    var fineMQ = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1200px)');
    if (!fineMQ.matches) return;

    var dot, ring;
    function ensureRefs() {
      dot  = document.getElementById('cursorDot');
      ring = document.getElementById('cursorRing');
      return dot && ring;
    }
    function setup() {
      if (!ensureRefs()) return;
      _setup();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
    function _setup() {

    var mouseX = -100, mouseY = -100;
    var ringX  = -100, ringY  = -100;
    var lerp = 0.18;

    function activate() {
      document.body.classList.add('cursor-ready');
      window.removeEventListener('mousemove', activate);
    }
    window.addEventListener('mousemove', activate);

    window.addEventListener('mousemove', function (e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (dot) dot.style.transform = 'translate3d(' + mouseX + 'px, ' + mouseY + 'px, 0) translate(-50%, -50%)';
    }, { passive: true });

    function tick() {
      ringX += (mouseX - ringX) * lerp;
      ringY += (mouseY - ringY) * lerp;
      if (ring) ring.style.transform = 'translate3d(' + ringX.toFixed(2) + 'px, ' + ringY.toFixed(2) + 'px, 0) translate(-50%, -50%)';
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    var interactiveSelector = 'a, button, [role="button"], input, textarea, select, [data-mob-go], [data-mob-back], [data-popup-close], .product, .post-card, .map-case-thumb, .map-hotspot, .ba-grip, .expand-toggle';
    document.addEventListener('mouseover', function (e) {
      if (e.target.closest && e.target.closest(interactiveSelector)) {
        document.body.classList.add('cursor-active');
      }
    });
    document.addEventListener('mouseout', function (e) {
      if (e.target.closest && e.target.closest(interactiveSelector)) {
        document.body.classList.remove('cursor-active');
      }
    });
    document.addEventListener('mousedown', function () { document.body.classList.add('cursor-pressing'); });
    document.addEventListener('mouseup',   function () { document.body.classList.remove('cursor-pressing'); });
    document.addEventListener('mouseleave', function () {
      if (dot)  dot.style.opacity  = '0';
      if (ring) ring.style.opacity = '0';
    });
    document.addEventListener('mouseenter', function () {
      if (dot)  dot.style.opacity  = '';
      if (ring) ring.style.opacity = '';
    });

    // After astro:after-swap the cursor elements may have been re-created
    // (transition:persist makes that rare, but be defensive).
    document.addEventListener('astro:after-swap', function () { ensureRefs(); });
    } /* end _setup */
  })();
</script>
</head>
<body data-mob-page={mobPage}>

<!-- Leaf source images embedded directly in the DOM. The HTML parser
     starts loading these the instant it sees them. The leaf script
     reads them out via getElementById + await img.decode(). -->
<img id="leafSrc1" src="/leaf%201.png" alt="" style="display:none" decoding="async" transition:persist>
<img id="leafSrc2" src="/leaf%202.png" alt="" style="display:none" decoding="async" transition:persist>
<img id="leafSrc4" src="/leaf%204.png" alt="" style="display:none" decoding="async" transition:persist>

<!-- Global background leaf field — full-viewport canvas, sits at z:50
     between the .viewport stage chrome and the cursor (z:9999). Same
     canvas powers desktop and mobile. -->
<canvas id="leafCanvas" aria-hidden="true" transition:persist></canvas>

<!-- Custom cursor — moss dot + lerping ring; desktop fine-pointer only.
     Persisted across view transitions so the cursor doesn't blink between routes. -->
<div class="cursor-ring" id="cursorRing" aria-hidden="true" transition:persist></div>
<div class="cursor-dot"  id="cursorDot"  aria-hidden="true" transition:persist></div>

<!-- ═════════════════════════════════════════════════════════════════════
     DESKTOP / FIXED-CANVAS VIEWPORT
     ═════════════════════════════════════════════════════════════════════ -->
<div class="viewport" id="viewport">

  <div class="stage-shell" id="stageShell">
  <div class="stage" id="stage">

    <!-- Persistent UI: logo top-left, begin top-right, sidenav left -->
    <a href="/" class="corner-logo" data-link aria-label="The Barnes Gardener, home">
      <span class="corner-logo-mark" aria-hidden="true"></span>
    </a>

    <a href="/quoteandrender" class="begin-btn" data-link>
      Get a quote and render now <span class="arr" aria-hidden="true">→</span>
    </a>

    <SideNav />

    <SiteFooter />

    <!-- Pages -->
    <div class="pages" id="pages">
      <slot />
    </div><!-- /.pages -->

    <!-- LOADING OVERLAY — anchored bulb stop-motion inside a moss ring.
         All four bulb sprite cells render at the same centre point;
         each one's transform offsets the cell's own bulb-body centroid
         so the bulb stays still while roots fan down and the bloom
         rises up. Step-end keyframes hard-flip between frames. -->
    <div class="loader" id="loader" aria-hidden="true" transition:persist>
      <div class="bulb-stage">
        <svg class="loader-ring" viewBox="0 0 132 132" aria-hidden="true">
          <circle class="loader-ring__track" cx="66" cy="66" r="60"></circle>
          <circle class="loader-ring__arc"   cx="66" cy="66" r="60"
                  stroke-dasharray="95 282"></circle>
        </svg>
        <div class="bulb-frame" data-i="0" aria-hidden="true"></div>
        <div class="bulb-frame" data-i="1" aria-hidden="true"></div>
        <div class="bulb-frame" data-i="2" aria-hidden="true"></div>
        <div class="bulb-frame" data-i="3" aria-hidden="true"></div>
      </div>
    </div>

  </div><!-- /.stage -->
  </div><!-- /.stage-shell -->
</div><!-- /.viewport -->


<!-- ═════════════════════════════════════════════════════════════════════
     MOBILE FALLBACK (separate scrollable layout, hidden on desktop)
     ═════════════════════════════════════════════════════════════════════ -->
<div class="mobile-shell">
  <MobileMenu />
  <slot name="mobile" />
</div>

<slot name="overlay" />

<!-- Mobile loader — thin moss circle with the bulb stop-motion growing inside -->
<div class="mob-loader" id="mobLoader" aria-hidden="true">
  <div class="mob-stage">
    <svg class="mob-ring" viewBox="0 0 132 132" aria-hidden="true">
      <circle class="mob-ring__track" cx="66" cy="66" r="60"></circle>
      <circle class="mob-ring__arc"   cx="66" cy="66" r="60"
              stroke-dasharray="95 282"></circle>
    </svg>

    <div class="mob-bulb-frame" data-i="0" role="img" aria-label="Bulb growing into flower"></div>
    <div class="mob-bulb-frame" data-i="1" aria-hidden="true"></div>
    <div class="mob-bulb-frame" data-i="2" aria-hidden="true"></div>
    <div class="mob-bulb-frame" data-i="3" aria-hidden="true"></div>
  </div>
</div>

<!-- Fixed-canvas scale-to-fit: lifts the 1440×900 stage and uniformly
     scales it to the largest factor that fits the viewport. Without this,
     the canvas overflows on smaller viewports and gets centre-clipped.
     Lifted verbatim from THE WEBSITE.html (lines 7038–7049). -->
<script is:inline>
  (function () {
    var STAGE_W = 1440;
    var STAGE_H = 900;
    function fitStage() {
      var shell = document.getElementById('stageShell');
      if (!shell) return;
      var scale = Math.min(window.innerWidth / STAGE_W, window.innerHeight / STAGE_H);
      shell.style.transform = 'translate(-50%, -50%) scale(' + scale + ')';
    }
    window.addEventListener('resize', fitStage);
    document.addEventListener('astro:after-swap', fitStage);
    document.addEventListener('astro:page-load', fitStage);
    fitStage();
  })();
</script>

<!-- Background leaf field — solid leaf silhouettes scattered across the
     viewport. Wind cone follows the cursor; ambient breeze keeps drift
     when idle. Lifted verbatim from THE WEBSITE.html script C
     (lines 8159–9499). The script is an IIFE that initialises once on
     first load; transition:persist on the canvas + leaf imgs above keeps
     the simulation running unbroken across Astro view-transitions. -->
<script src="/scripts/leaf-field.js" is:inline></script>

<!-- Blog "What's Growing" iOS-style popup + blur veil. Lifted from
     THE WEBSITE.html script B (lines 7666–7831). Markup lives in the
     overlay slot of blog.astro; the script defers to DOMContentLoaded
     and re-fires on astro:after-swap so navigations into /blog still
     trigger the popup. -->
<script src="/scripts/blog-popup.js" is:inline></script>

<!-- Mobile menu open/close. The desktop sidenav is rendered always;
     the mobile hamburger overlay shows only at the mobile breakpoint
     and toggles via body.mob-menu-open. -->
<script is:inline>
  (function () {
    function open()  { document.body.classList.add('mob-menu-open'); var t = document.getElementById('mobMenuToggle'); if (t) { t.setAttribute('aria-expanded', 'true');  t.setAttribute('aria-label', 'Close menu'); } }
    function close() { document.body.classList.remove('mob-menu-open'); var t = document.getElementById('mobMenuToggle'); if (t) { t.setAttribute('aria-expanded', 'false'); t.setAttribute('aria-label', 'Open menu'); } }
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('#mobMenuToggle')) {
        e.preventDefault();
        if (document.body.classList.contains('mob-menu-open')) close(); else open();
        return;
      }
      if (e.target.closest && e.target.closest('#mobMenuBackdrop')) {
        close();
        return;
      }
      // Tapping any link inside the overlay closes it; Astro then navigates.
      if (e.target.closest && e.target.closest('.mob-menu-overlay a[href]')) {
        close();
      }
    });
    document.addEventListener('astro:after-swap', close);
  })();
</script>

</body>
</html>
