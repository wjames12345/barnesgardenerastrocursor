---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SideNav from '../components/SideNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const DEFAULT_TITLE = 'The Barnes Gardener · Gary Hazell';
const DEFAULT_DESCRIPTION = 'Considered, sustainable gardening for Barnes and South West London. By Gary Hazell, independent since 2016.';
const DEFAULT_OG_IMAGE = '/logo-wordmark.png';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;

// data-mob-page drives the mobile section visibility rules at source 4143–4162.
// /latelier maps to "generator" — mobile uses the "generator" slug for the
// Vision-and-Quote page (matches #m-generator markup).
const PATH_TO_MOB_PAGE: Record<string, string> = {
  '/':         'home',
  '/about':    'about',
  '/services': 'services',
  '/gardens':  'gardens',
  '/latelier': 'generator',
  '/blog':     'blog',
  '/podcast':  'podcast',
  '/shop':     'shop',
  '/contact':  'contact',
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// /case/[road] sub-routes have no mobile equivalent in source; fall back to
// "gardens" so mobile users land on the gardens grid rather than the home wordmark.
const mobPage = path.startsWith('/case/') ? 'gardens' : (PATH_TO_MOB_PAGE[path] ?? 'home');

// Canonical and absolute OG image URL — Astro.site is set in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL   = new URL(ogImage, Astro.site).toString();

// LocalBusiness JSON-LD — boosts "barnes gardener" / "gardener barnes" queries.
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'The Barnes Gardener',
  description: DEFAULT_DESCRIPTION,
  url: Astro.site?.toString(),
  telephone: '+447770450523',
  email: 'gary@thebarnesgardener.co.uk',
  priceRange: '££',
  founder: { '@type': 'Person', name: 'Gary Hazell' },
  foundingDate: '2016',
  areaServed: [
    'Barnes', 'Richmond', 'Wimbledon', 'Kingston', 'Putney',
    'Chelsea', 'Kensington', 'Notting Hill', 'Brentford', "Shepherd's Bush",
  ],
  sameAs: ['https://instagram.com/thebarnesgardener'],
  image: new URL('/logo-wordmark.png', Astro.site).toString(),
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no, viewport-fit=cover">

<!-- Hash-route migration shim: catches inbound links from the old SPA's
     /#about /#services etc. and redirects to /about /services etc. before paint.
     Inert when no hash is present. /#case and /#map fall back to /gardens since
     deep-link road state isn't preserved across the migration. -->
<script is:inline>
  (function () {
    var h = location.hash.replace(/^#m?-?/, '');
    if (!h) return;
    var map = {
      home: '/', about: '/about', services: '/services', gardens: '/gardens',
      latelier: '/latelier', generator: '/latelier', blog: '/blog',
      podcast: '/podcast', shop: '/shop', contact: '/contact',
      'case': '/gardens', map: '/gardens'
    };
    var target = map[h];
    if (target && location.pathname !== target) location.replace(target);
  })();
</script>

<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F7F2E5">
<meta name="color-scheme" content="light">

<link rel="canonical" href={canonicalURL}>

<meta property="og:type" content="website">
<meta property="og:site_name" content="The Barnes Gardener">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta property="og:locale" content="en_GB">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageURL}>

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Gary">
<link rel="apple-touch-icon" href="/ampersand.png">
<link rel="manifest" href="/manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="/BULB TO FLOWER.png" fetchpriority="high">

<script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

<ClientRouter />

<!-- Smart page-transition loader: bulb-to-flower cascade only shows when a
     navigation hasn't completed within ~200ms. Fast navs get no loader at all
     (no flash). Slow navs get a 0.55s cascade as a perceptual bridge. -->
<script is:inline>
  (function () {
    var THRESHOLD = 200;
    var timer = null;
    function showLoader() {
      var l = document.getElementById('loader');
      if (l) l.classList.add('visible');
    }
    function hideLoader() {
      if (timer) { clearTimeout(timer); timer = null; }
      var l = document.getElementById('loader');
      if (l) l.classList.remove('visible');
    }
    document.addEventListener('astro:before-preparation', function () {
      timer = setTimeout(showLoader, THRESHOLD);
    });
    document.addEventListener('astro:after-swap', hideLoader);
    // Defensive: clear stale timer if user aborts navigation mid-flight.
    document.addEventListener('astro:before-swap', function () {
      if (timer) { clearTimeout(timer); timer = null; }
    });
  })();
</script>

<!-- Custom cursor IIFE — lifted verbatim from source script B 8051–8110.
     Runs once on initial load; window listeners + persisted DOM survive view transitions. -->
<script is:inline>
  (function () {
    var fineMQ = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1200px)');
    if (!fineMQ.matches) return;

    var dot, ring;
    function ensureRefs() {
      dot  = document.getElementById('cursorDot');
      ring = document.getElementById('cursorRing');
      return dot && ring;
    }
    if (!ensureRefs()) return;

    var mouseX = -100, mouseY = -100;
    var ringX  = -100, ringY  = -100;
    var lerp = 0.18;

    function activate() {
      document.body.classList.add('cursor-ready');
      window.removeEventListener('mousemove', activate);
    }
    window.addEventListener('mousemove', activate);

    window.addEventListener('mousemove', function (e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (dot) dot.style.transform = 'translate3d(' + mouseX + 'px, ' + mouseY + 'px, 0) translate(-50%, -50%)';
    }, { passive: true });

    function tick() {
      ringX += (mouseX - ringX) * lerp;
      ringY += (mouseY - ringY) * lerp;
      if (ring) ring.style.transform = 'translate3d(' + ringX.toFixed(2) + 'px, ' + ringY.toFixed(2) + 'px, 0) translate(-50%, -50%)';
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    var interactiveSelector = 'a, button, [role="button"], input, textarea, select, [data-mob-go], [data-mob-back], [data-popup-close], .product, .post-card, .map-case-thumb, .map-hotspot, .ba-grip, .expand-toggle';
    document.addEventListener('mouseover', function (e) {
      if (e.target.closest && e.target.closest(interactiveSelector)) {
        document.body.classList.add('cursor-active');
      }
    });
    document.addEventListener('mouseout', function (e) {
      if (e.target.closest && e.target.closest(interactiveSelector)) {
        document.body.classList.remove('cursor-active');
      }
    });
    document.addEventListener('mousedown', function () { document.body.classList.add('cursor-pressing'); });
    document.addEventListener('mouseup',   function () { document.body.classList.remove('cursor-pressing'); });
    document.addEventListener('mouseleave', function () {
      if (dot)  dot.style.opacity  = '0';
      if (ring) ring.style.opacity = '0';
    });
    document.addEventListener('mouseenter', function () {
      if (dot)  dot.style.opacity  = '';
      if (ring) ring.style.opacity = '';
    });

    // After astro:after-swap the cursor elements may have been re-created
    // (transition:persist makes that rare, but be defensive).
    document.addEventListener('astro:after-swap', function () { ensureRefs(); });
  })();
</script>
</head>
<body data-mob-page={mobPage}>

<!-- Custom cursor — moss dot + lerping ring; desktop fine-pointer only.
     Persisted across view transitions so the cursor doesn't blink between routes. -->
<div class="cursor-ring" id="cursorRing" aria-hidden="true" transition:persist></div>
<div class="cursor-dot"  id="cursorDot"  aria-hidden="true" transition:persist></div>

<!-- ═════════════════════════════════════════════════════════════════════
     DESKTOP / FIXED-CANVAS VIEWPORT
     ═════════════════════════════════════════════════════════════════════ -->
<div class="viewport" id="viewport">

  <div class="stage-shell" id="stageShell">
  <div class="stage" id="stage">

    <!-- Persistent UI: logo top-left, begin top-right, sidenav left -->
    <a href="/" class="corner-logo" data-link aria-label="The Barnes Gardener, home">
      <span class="corner-logo-mark" aria-hidden="true"></span>
    </a>

    <a href="/latelier" class="begin-btn" data-link>
      Begin a vision <span class="arr" aria-hidden="true">→</span>
    </a>

    <SideNav />

    <SiteFooter />

    <!-- Pages -->
    <div class="pages" id="pages">
      <slot />
    </div><!-- /.pages -->

    <!-- LOADING OVERLAY (4 stacked composites, each clipped to one bulb, cascading flash) -->
    <div class="loader" id="loader" aria-hidden="true" transition:persist>
      <div class="bulb-stage">
        <img src="/BULB TO FLOWER.png" alt="" style="--i: 0">
        <img src="/BULB TO FLOWER.png" alt="" style="--i: 1">
        <img src="/BULB TO FLOWER.png" alt="" style="--i: 2">
        <img src="/BULB TO FLOWER.png" alt="" style="--i: 3">
      </div>
    </div>

  </div><!-- /.stage -->
  </div><!-- /.stage-shell -->
</div><!-- /.viewport -->


<!-- ═════════════════════════════════════════════════════════════════════
     MOBILE FALLBACK (separate scrollable layout, hidden on desktop)
     ═════════════════════════════════════════════════════════════════════ -->
<div class="mobile-shell">
  <MobileMenu />
  <slot name="mobile" />
</div>

<slot name="overlay" />

<!-- Mobile loader — thin moss circle with the bulb stop-motion growing inside -->
<div class="mob-loader" id="mobLoader" aria-hidden="true">
  <div class="mob-stage">
    <svg class="mob-ring" viewBox="0 0 132 132" aria-hidden="true">
      <circle class="mob-ring__track" cx="66" cy="66" r="60"></circle>
      <circle class="mob-ring__arc"   cx="66" cy="66" r="60"
              stroke-dasharray="95 282"></circle>
    </svg>

    <div class="mob-bulb-frame" data-i="0" role="img" aria-label="Bulb growing into flower"></div>
    <div class="mob-bulb-frame" data-i="1" aria-hidden="true"></div>
    <div class="mob-bulb-frame" data-i="2" aria-hidden="true"></div>
    <div class="mob-bulb-frame" data-i="3" aria-hidden="true"></div>
  </div>
</div>

</body>
</html>
