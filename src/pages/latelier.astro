---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="page page-latelier" id="latelier">
    <div class="page-inner">
      <div class="lat-grid">
        <div class="lat-left">
          <h2 class="fade-in" style="--fade-delay: 0.0s;">Upload a <em>photograph</em>.</h2>
          <p class="lat-lead fade-in" style="--fade-delay: 0.15s;">Upload a photo and I will send you back my vision of what I can offer along with a quote within 24 hours.</p>
        </div>

        <div class="lat-right fade-in" style="--fade-delay: 0.45s;">
          <form class="lat-form" id="envForm" novalidate>
            <div class="form-row single">
              <div class="field field-with-cursor" data-cursor>
                <label for="env-vision">What would you like?</label>
                <textarea id="env-vision" name="vision" placeholder="A few words. What you'd love, what isn't working."></textarea>
                <span class="typewriter-cursor"></span>
              </div>
            </div>
            <div class="form-row single" style="margin-bottom: 30px;">
              <div class="field">
                <label>A photograph of your garden</label>
                <div class="file-button-row">
                  <label class="file-button">
                    <span class="dot"></span>
                    <span>Choose File…</span>
                    <input type="file" id="env-photo" name="photo" accept="image/*">
                  </label>
                  <span class="file-status" id="fileStatus"><span class="label">No file</span>selected</span>
                </div>
              </div>
            </div>
            <div class="form-row">
              <div class="field field-with-cursor" data-cursor>
                <label for="env-name">Your name</label>
                <input type="text" id="env-name" name="name" placeholder="Jane Doe" required>
                <span class="typewriter-cursor"></span>
              </div>
              <div class="field field-with-cursor" data-cursor>
                <label for="env-email">Your email so we can get back to you</label>
                <input type="email" id="env-email" name="email" placeholder="you@example.com" required>
                <span class="typewriter-cursor"></span>
              </div>
            </div>
            <button type="submit" class="submit">
              <span>Send to Gary</span>
              <span class="arrow" aria-hidden="true">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </button>
          </form>
          <div class="form-success" id="envSuccess">
            <div class="success-eyebrow"><span class="pulse"></span>Received · in queue</div>
            <h3>Your garden is on Gary's <em>bench</em>.</h3>
            <p>He'll have something back to you within 24 hours.</p>
            <div class="receipt">
              <div class="row"><span class="k">Status</span><span class="v" id="receiptStatus">awaiting review</span></div>
              <div class="row"><span class="k">Reply by</span><span class="v" id="receiptReply">·</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mob-section" id="m-generator" slot="mobile">
    <button class="mob-page-back" type="button" data-mob-back aria-label="Back to home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <p class="lead">Upload a photo and I will send you back my vision of what I can offer along with a quote within 24 hours.</p>

    <form class="mob-gen-form" id="mobGenForm" novalidate>
      <div class="field">
        <textarea id="mob-vision" name="vision" placeholder="What would you like? Click here to type!" rows="2"></textarea>
      </div>

      <label class="mob-gen-photo" for="mob-photo">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><polyline points="21 16 16 11 5 19"/></svg>
        <span id="mobPhotoLabel">Upload Photo</span>
        <input type="file" id="mob-photo" name="photo" accept="image/*" capture="environment">
      </label>
      <span class="mob-gen-photo-status" id="mobPhotoStatus">No photo selected</span>

      <div class="field">
        <label for="mob-name">Your name</label>
        <input type="text" id="mob-name" name="name" placeholder="Your Name" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="mob-email">Your email so we can get back to you</label>
        <input type="email" id="mob-email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" required>
      </div>

      <button type="submit" class="mob-gen-submit">Send to Gary</button>
    </form>
  </section>
</BaseLayout>
