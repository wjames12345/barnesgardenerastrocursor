---
import BaseLayout from '../layouts/BaseLayout.astro';

const TILES = [
  { road: 'Castelnau',         area: 'Barnes' },
  { road: 'Lonsdale Road',     area: 'Barnes' },
  { road: 'Riverview Gardens', area: 'Barnes' },
  { road: 'Westmoreland Road', area: 'Barnes' },
  { road: 'Lytton Grove',      area: 'Putney' },
  { road: 'Carlton Drive',     area: 'Putney' },
  { road: 'Disraeli Road',     area: 'Putney' },
  { road: 'Erpingham Road',    area: 'Putney' },
];

const slugify = (road: string) => road.toLowerCase().replace(/\s+/g, '-');
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---
<BaseLayout>
  <section class="page page-gardens active" id="gardens">
    <div class="page-inner">
      <div class="gardens-head fade-in" style="--fade-delay: 0.0s;">
        <h2>Testimonial Gardens</h2>
      </div>

      <div class="gardens-grid fade-in" style="--fade-delay: 0.12s;">
        {TILES.map((t) => (
          <a class="gardens-tile" href={`/case/${slugify(t.road)}`} data-road={t.road} data-area={t.area} aria-label={`${t.road}, ${t.area}`}>
            <img src={PIXEL} alt="" loading="lazy" decoding="async">
            <span class="gardens-tile-name">{t.road}</span>
            <span class="gardens-tile-area">{t.area}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mob-section" id="m-gardens" slot="mobile">
    <button class="mob-page-back" type="button" data-mob-back aria-label="Back to home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <h2 class="mob-gardens-title">Testimonial Gardens</h2>

    <div class="mob-gardens-list">
      {TILES.map((t) => (
        <a class="mob-gardens-card" href={`/case/${slugify(t.road)}`} data-road={t.road} data-area={t.area}>
          <img src={PIXEL} alt="" loading="lazy" decoding="async">
          <span class="mob-gardens-card-name">{t.road}</span>
          <span class="mob-gardens-card-area">{t.area}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
