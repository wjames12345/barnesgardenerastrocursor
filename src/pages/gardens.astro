---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="page page-gardens" id="gardens">
    <div class="page-inner">
      <div class="gardens-head fade-in" style="--fade-delay: 0.0s;">
        <h2>Testimonial Gardens</h2>
      </div>

      <div class="gardens-grid fade-in" style="--fade-delay: 0.12s;">
        <a class="gardens-tile" data-road="Castelnau" data-area="Barnes" aria-label="Castelnau, Barnes">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Castelnau</span>
          <span class="gardens-tile-area">Barnes</span>
        </a>
        <a class="gardens-tile" data-road="Lonsdale Road" data-area="Barnes" aria-label="Lonsdale Road, Barnes">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Lonsdale Road</span>
          <span class="gardens-tile-area">Barnes</span>
        </a>
        <a class="gardens-tile" data-road="Riverview Gardens" data-area="Barnes" aria-label="Riverview Gardens, Barnes">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Riverview Gardens</span>
          <span class="gardens-tile-area">Barnes</span>
        </a>
        <a class="gardens-tile" data-road="Westmoreland Road" data-area="Barnes" aria-label="Westmoreland Road, Barnes">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Westmoreland Road</span>
          <span class="gardens-tile-area">Barnes</span>
        </a>
        <a class="gardens-tile" data-road="Lytton Grove" data-area="Putney" aria-label="Lytton Grove, Putney">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Lytton Grove</span>
          <span class="gardens-tile-area">Putney</span>
        </a>
        <a class="gardens-tile" data-road="Carlton Drive" data-area="Putney" aria-label="Carlton Drive, Putney">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Carlton Drive</span>
          <span class="gardens-tile-area">Putney</span>
        </a>
        <a class="gardens-tile" data-road="Disraeli Road" data-area="Putney" aria-label="Disraeli Road, Putney">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Disraeli Road</span>
          <span class="gardens-tile-area">Putney</span>
        </a>
        <a class="gardens-tile" data-road="Erpingham Road" data-area="Putney" aria-label="Erpingham Road, Putney">
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
          <span class="gardens-tile-name">Erpingham Road</span>
          <span class="gardens-tile-area">Putney</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mob-section" id="m-gardens" slot="mobile">
    <button class="mob-page-back" type="button" data-mob-back aria-label="Back to home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <h2 class="mob-gardens-title">Testimonial Gardens</h2>

    <div class="mob-gardens-list">
      <a class="mob-gardens-card" data-road="Castelnau" data-area="Barnes">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Castelnau</span>
        <span class="mob-gardens-card-area">Barnes</span>
      </a>
      <a class="mob-gardens-card" data-road="Lonsdale Road" data-area="Barnes">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Lonsdale Road</span>
        <span class="mob-gardens-card-area">Barnes</span>
      </a>
      <a class="mob-gardens-card" data-road="Riverview Gardens" data-area="Barnes">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Riverview Gardens</span>
        <span class="mob-gardens-card-area">Barnes</span>
      </a>
      <a class="mob-gardens-card" data-road="Westmoreland Road" data-area="Barnes">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Westmoreland Road</span>
        <span class="mob-gardens-card-area">Barnes</span>
      </a>
      <a class="mob-gardens-card" data-road="Lytton Grove" data-area="Putney">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Lytton Grove</span>
        <span class="mob-gardens-card-area">Putney</span>
      </a>
      <a class="mob-gardens-card" data-road="Carlton Drive" data-area="Putney">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Carlton Drive</span>
        <span class="mob-gardens-card-area">Putney</span>
      </a>
      <a class="mob-gardens-card" data-road="Disraeli Road" data-area="Putney">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Disraeli Road</span>
        <span class="mob-gardens-card-area">Putney</span>
      </a>
      <a class="mob-gardens-card" data-road="Erpingham Road" data-area="Putney">
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" loading="lazy" decoding="async">
        <span class="mob-gardens-card-name">Erpingham Road</span>
        <span class="mob-gardens-card-area">Putney</span>
      </a>
    </div>
  </section>
</BaseLayout>
