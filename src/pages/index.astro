---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="The Barnes Gardener · Independent Gardening, Barnes & SW London"
  description="Considered, sustainable gardening for Barnes and South West London. Garden renovation, planting, lawn care and ornament. By Gary Hazell, independent since 2016."
>
  <section class="page page-home active" id="home">
    <div class="page-inner">
      <h1 class="wordmark" id="wordmark">
        <span class="wordmark-img" role="img" aria-label="The Barnes Gardener"></span>
      </h1>

      <div class="home-signature">Established by Gary Hazell in 2016 &amp; independent ever since.</div>

      <!-- Conveyor belt of areas served -->
      <div class="conveyor" id="conveyor">
        <div class="conveyor-track" id="conveyorTrack">
          <!-- pills injected here by JS, doubled for seamless loop -->
        </div>
      </div>
    </div>
  </section>

  <section class="mob-hero" id="m-home" slot="mobile">
    <h1 class="mob-hero-title mob-hero-title--logo">
      <span class="mob-hero-logo-img" role="img" aria-label="The Barnes Gardener"></span>
    </h1>

  </section>
</BaseLayout>
