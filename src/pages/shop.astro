---
import BaseLayout from '../layouts/BaseLayout.astro';

// Brand-led editorial list — six sections, each in its own block.
const brands = [
  {
    slug: 'felco',
    name: 'Felco',
    where: 'Switzerland · since 1945',
    note: 'First Felco in 2008. Still the cleanest cut on the bench.',
    body: 'The Felco 2 is the workhorse — every gardener I respect carries one. Replaceable parts, sharpenable blades, an ergonomic handle that doesn\'t fight your wrist on a long pruning day. I\'ve never had to throw one out. Repaired, yes; replaced, no.',
    link: 'https://www.niwaki.com/c/felco/',
    linkLabel: 'Find Felco at Niwaki',
  },
  {
    slug: 'niwaki',
    name: 'Niwaki',
    where: 'Japan · via Dorset',
    note: 'Japanese steel that holds an edge longer than anything else.',
    body: 'Tripod ladders, sentei snips, hori-hori knives. The materials are a different conversation — high-carbon steel, hand-finished handles, made for a craft tradition that takes pruning seriously. Niwaki source from small Japanese workshops and import them to a yard in Dorset. The price is honest for what arrives.',
    link: 'https://www.niwaki.com/',
    linkLabel: 'Visit Niwaki',
  },
  {
    slug: 'stihl',
    name: 'Stihl',
    where: 'Germany · since 1926',
    note: 'The cordless range is the only power kit I trust on a job.',
    body: 'Battery hedge trimmers, blowers and a small chainsaw — the AP system means one battery fits the whole set. Reliable, dealer-supported, and quiet enough that a Saturday job in a Barnes back garden doesn\'t become the neighbour\'s problem. The bar-and-chain quality is the reason cordless finally works.',
    link: 'https://www.stihl.co.uk/',
    linkLabel: 'Find your Stihl dealer',
  },
  {
    slug: 'wolfgarten',
    name: 'Wolf-Garten',
    where: 'Germany · since 1922',
    note: 'One handle, a dozen tool heads. The system that earned its place.',
    body: 'The multi-change handle is the trick — one wooden shaft, a quick-release coupling, and the trowel becomes a hoe becomes a rake. Less to carry, less to store, less to lose. The steel is strong; the heads sharpen well; and a single handle outlasting a decade of heads is the kind of frugality this site believes in.',
    link: 'https://www.wolfgarten-tools.co.uk/',
    linkLabel: 'Browse Wolf-Garten',
  },
  {
    slug: 'aspley',
    name: 'Aspley Farm',
    where: 'Bedfordshire · family-run',
    note: 'Topsoil and turf-loam from a farm that knows what it grew it on.',
    body: 'For renovation jobs that need real volume — bed-building, levelling, regrading — Aspley\'s screened topsoil is what I order. They know their fields, they know what they\'ve composted, and they deliver bagged or loose without the markup of the chain merchants. Family-run; you talk to people who actually farm the stuff.',
    link: 'https://www.aspleyfarm.co.uk/',
    linkLabel: 'Order from Aspley',
  },
  {
    slug: 'sylvagrow',
    name: 'Melcourt SylvaGrow',
    where: 'Gloucestershire · peat-free since day one',
    note: 'The peat-free compost that genuinely behaves like the old peat mixes.',
    body: 'Most peat-free composts let you down — they dry out, they go anaerobic, the structure collapses. SylvaGrow doesn\'t. RHS-endorsed, made from forestry by-products on a Cotswold mill, and water-holding without ever turning to mud. It\'s the only mix I\'ll specify for client beds and pots.',
    link: 'https://www.melcourt.co.uk/sylvagrow/',
    linkLabel: 'Find SylvaGrow stockists',
  },
];
---
<BaseLayout
  title="Gary's Kit Shop — Tools, Compost & Brands I Trust · The Barnes Gardener"
  description="The tools, gloves and compost Gary actually uses. Felco, Niwaki, Stihl, Wolf-Garten, Aspley Farm, SylvaGrow — independent picks, tested on real gardens, recommended without commission."
>
  <section class="page page-shop active" id="shop">
    <div class="page-inner" id="shopInner">

      <div class="shop-head fade-in" style="--fade-delay: 0.0s;">
        <h2>Gary's Kit Shop</h2>
        <p class="shop-lead">Tools, gloves and compost I actually use. Independent, tested, recommended.</p>
      </div>

      <div class="shop-brands">
        {brands.map((b, i) => (
          <article class="shop-brand fade-in" style={`--fade-delay: ${0.15 + i * 0.06}s;`}>
            <div class="shop-brand-left">
              <img class="shop-brand-logo" src={`/logos/${b.slug}.png`} alt={b.name} />
              <p class="shop-brand-where">{b.where}</p>
              <p class="shop-brand-note">{b.note}</p>
            </div>
            <div class="shop-brand-right">
              <h3 class="shop-brand-name">{b.name}</h3>
              <p class="shop-brand-body">{b.body}</p>
              <a class="shop-brand-link" href={b.link} target="_blank" rel="noopener">
                {b.linkLabel}
                <span class="arr" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <section class="mob-section" id="m-shop" slot="mobile">
    <button class="mob-page-back" type="button" data-mob-back aria-label="Back to home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <h2>Gary's Kit Shop.</h2>
    <p class="lead">Tools, gloves and compost I actually use.</p>

    <ul class="mob-shop-brands">
      {brands.map((b) => (
        <li class="mob-shop-brand">
          <img class="mob-shop-brand-logo" src={`/logos/${b.slug}.png`} alt={b.name} />
          <h3 class="mob-shop-brand-name">{b.name}</h3>
          <p class="mob-shop-brand-where">{b.where}</p>
          <p class="mob-shop-brand-body">{b.body}</p>
          <a class="mob-shop-brand-link" href={b.link} target="_blank" rel="noopener">
            {b.linkLabel} →
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
