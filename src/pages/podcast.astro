---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="page page-podcast active" id="podcast">
    <div class="page-inner">
      <div class="fade-in" style="--fade-delay: 0.0s;">
        <h2 class="podcast-headline">The <em>Gardening with Gary</em> Podcast,<br>Coming Soon.</h2>
        <p class="podcast-sub">Sign up for updates using your email below.</p>
        <form class="podcast-form" id="podcastForm" novalidate>
          <input type="email" name="email" placeholder="your@email.com" autocomplete="email" inputmode="email" required>
          <button type="submit">Submit</button>
        </form>
        <p class="podcast-thanks" id="podcastThanks">Thanks. I'll be in touch.</p>
      </div>
    </div>
  </section>

  <section class="mob-section" id="m-podcast" slot="mobile">
    <button class="mob-page-back" type="button" data-mob-back aria-label="Back to home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <h2 class="mob-podcast-headline">The <em>Gardening with Gary</em> Podcast,<br>Coming Soon.</h2>
    <p class="mob-podcast-sub">Sign up for updates using your email below.</p>
    <form class="mob-podcast-form" id="mobPodcastForm" novalidate>
      <input type="email" name="email" placeholder="your@email.com" autocomplete="email" inputmode="email" required>
      <button type="submit">Submit</button>
    </form>
    <p class="mob-podcast-thanks" id="mobPodcastThanks">Thanks. I'll be in touch.</p>
  </section>
</BaseLayout>
