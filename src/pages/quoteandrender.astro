---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Quote & Render — Photo Renderings · The Barnes Gardener"
  description="Send a photograph of your garden. Get a rendering and a written quote within 24 hours, no obligation. Quote & Render by The Barnes Gardener."
>
  <section class="page page-latelier active" id="quoteandrender">
    <div class="page-inner">
      <header class="lat-head fade-in" style="--fade-delay: 0.0s;">
        <h2>Upload a photograph.</h2>
        <p class="lat-lead">Upload a photo and I will send you back my vision of what I can offer along with a quote within 24 hours.</p>
      </header>

      <div class="lat-body fade-in" style="--fade-delay: 0.3s;">
        <form class="lat-form" id="envForm" novalidate>
          <div class="form-row single">
            <div class="field">
              <label for="env-vision">What would you like?</label>
              <textarea id="env-vision" name="vision" placeholder="A few words. What you'd love, what isn't working."></textarea>
            </div>
          </div>
          <div class="form-row single">
            <div class="field">
              <label>A photograph of your garden</label>
              <div class="file-button-row">
                <label class="file-button">
                  <span class="dot"></span>
                  <span>Choose File…</span>
                  <input type="file" id="env-photo" name="photo" accept="image/*">
                </label>
                <span class="file-status" id="fileStatus"><span class="label">No file</span> selected</span>
              </div>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="env-name">Your name</label>
              <input type="text" id="env-name" name="name" placeholder="Jane Doe" required>
            </div>
            <div class="field">
              <label for="env-email">Your email so we can get back to you</label>
              <input type="email" id="env-email" name="email" placeholder="you@example.com" required>
            </div>
          </div>
        </form>

        <div class="lat-submit-col">
          <button type="submit" form="envForm" class="lat-submit">
            <span>Send to Gary</span>
            <span class="arr" aria-hidden="true">→</span>
          </button>
          <p class="lat-nospam">Your photo and email never leave Gary's inbox.</p>
        </div>
      </div>

      <ul class="lat-promise fade-in" style="--fade-delay: 0.45s;">
        <li><span class="lat-promise-k">Photo rendering</span><span class="lat-promise-v">A visual of how your garden could look.</span></li>
        <li><span class="lat-promise-k">Written quote</span><span class="lat-promise-v">Cost, scope and what's included.</span></li>
        <li><span class="lat-promise-k">24-hour reply</span><span class="lat-promise-v">Direct from Gary, no third party.</span></li>
      </ul>

      <div class="lat-success" id="envSuccess" hidden>
        <div class="lat-success-stage">
          <div class="lat-success-text">
            <h3 class="lat-success-h">Your garden is on<br>Gary's bench.</h3>
            <p class="lat-success-body">He'll have something back to you within 24 hours.</p>
          </div>
          <img class="lat-success-bench" src="/bench.png" alt="" aria-hidden="true">
        </div>
      </div>
    </div>
  </section>

  <section class="mob-section" id="m-generator" slot="mobile">
    <h2>Quote &amp; Render.</h2>
    <p class="lead">Upload a photo and I will send back a vision of what I can offer along with a quote within 24 hours.</p>

    <form class="mob-gen-form" id="mobGenForm" novalidate>
      <div class="field">
        <textarea id="mob-vision" name="vision" placeholder="What would you like? Click here to type!" rows="2"></textarea>
      </div>

      <label class="mob-gen-photo" for="mob-photo">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><polyline points="21 16 16 11 5 19"/></svg>
        <span id="mobPhotoLabel">Upload Photo</span>
        <input type="file" id="mob-photo" name="photo" accept="image/*" capture="environment">
      </label>
      <span class="mob-gen-photo-status" id="mobPhotoStatus">No photo selected</span>

      <div class="field">
        <label for="mob-name">Your name</label>
        <input type="text" id="mob-name" name="name" placeholder="Your Name" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="mob-email">Your email so we can get back to you</label>
        <input type="email" id="mob-email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" required>
      </div>

      <button type="submit" class="mob-gen-submit">Send to Gary</button>
    </form>

    <!-- Mobile success card. Mirrors the desktop /quoteandrender success
         layout but stacks for portrait phone screens. -->
    <div class="mob-gen-success" id="mobGenSuccess" hidden>
      <h3 class="mob-gen-success-h">Your garden is on<br>Gary's bench.</h3>
      <p class="mob-gen-success-body">He'll have something back to you within 24 hours.</p>
      <img class="mob-gen-success-bench" src="/bench.png" alt="" aria-hidden="true">
    </div>
  </section>

  <!-- Form handlers — desktop + mobile. Intercept submit, hide form +
       supporting elements, reveal the success card with the big
       "your garden is on Gary's bench" headline. Stamp the receipt's
       reply-by row with a 24-hour-from-now timestamp. -->
  <script is:inline>
    (function () {
      // Marker prevents double-binding when this runs on both page-load
      // and after-swap events.
      function wire(formId, hideSelectors, successId) {
        var form = document.getElementById(formId);
        if (!form || form.dataset.qrWired) return;
        form.dataset.qrWired = '1';
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          hideSelectors.forEach(function (sel) {
            var el = document.querySelector(sel);
            if (el) el.style.display = 'none';
          });
          var success = document.getElementById(successId);
          if (success) {
            success.removeAttribute('hidden');
            success.style.display = 'block';   // belt-and-braces in case [hidden] override lingers
            // Wait one frame so the layout has updated, then scroll the
            // success card into view.
            requestAnimationFrame(function () {
              success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
          }
        });
      }
      function setup() {
        // Desktop: hide the entire .lat-body (form + submit pill) and
        // the promise row so only the head + success card remain.
        wire('envForm', ['.lat-body', '.lat-promise'], 'envSuccess');
        // Mobile: hide the heading, lead, form — show the dedicated
        // mobile success block (#mobGenSuccess).
        wire('mobGenForm', ['#m-generator > h2', '#m-generator > .lead', '#mobGenForm'], 'mobGenSuccess');
      }
      // Run on initial load AND every Astro client-side navigation, so
      // the handler is attached whether the user lands directly on
      // /quoteandrender or arrives via the sidenav.
      setup();
      document.addEventListener('astro:after-swap', setup);
      document.addEventListener('astro:page-load', setup);
    })();
  </script>
</BaseLayout>
