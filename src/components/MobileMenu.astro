---
// Active state matches the desktop sidenav: terracotta on the picked
// item. Computed from the current pathname so the menu reflects the
// active page without JS.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  if (href === '/gardens') return path === '/gardens' || path.startsWith('/case/');
  return path === href || path.startsWith(href + '/');
};
const cls = (href: string) => 'mob-menu-label' + (isActive(href) ? ' active' : '');
---
<!-- Brand mark — retired (CSS hides it) but kept for any legacy back-
     navigation flows that still query data-mob-back. -->
<a class="mob-brand" href="/" data-mob-back aria-label="Home">
  <span class="mob-brand-mark" role="img" aria-label="The Barnes Gardener"></span>
</a>

<!-- Hamburger toggle — sits top-right on every mobile screen. Tap to fade
     the page to the cream background and reveal the all-caps overlay
     menu. Three thin bars morph into an X when open. -->
<button class="mob-menu-toggle" id="mobMenuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobMenuOverlay">
  <span class="bars" aria-hidden="true"><span></span></span>
</button>

<!-- Cream wash that fades in behind the menu, hiding the page content. -->
<div class="mob-menu-backdrop" id="mobMenuBackdrop" aria-hidden="true"></div>

<!-- Overlay menu, revealed when .mob-menu-open is set on <body>. -->
<div class="mob-menu-overlay" id="mobMenuOverlay" role="dialog" aria-modal="true" aria-label="Site menu">
  <ul class="mob-menu-list" id="mobMenuList">
    <li class="mob-menu-item" data-mob-key="home">
      <div class="mob-menu-row">
        <a class={cls('/')} href="/" data-mob-go="home">Home</a>
        <button class="mob-menu-expand" type="button" aria-expanded="false" aria-label="About this section">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <a class="mob-menu-go" href="/" data-mob-go="home" aria-label="Open home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="mob-menu-desc"><p>The wordmark and the wind. Always one tap away.</p></div>
    </li>

    <li class="mob-menu-item" data-mob-key="about">
      <div class="mob-menu-row">
        <a class={cls('/about')} href="/about" data-mob-go="about">About</a>
        <button class="mob-menu-expand" type="button" aria-expanded="false" aria-label="About this section">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <a class="mob-menu-go" href="/about" data-mob-go="about" aria-label="Open about">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="mob-menu-desc"><p>An independent gardener renovating gardens across Barnes and South West London since 2016.</p></div>
    </li>

    <li class="mob-menu-item" data-mob-key="services">
      <div class="mob-menu-row">
